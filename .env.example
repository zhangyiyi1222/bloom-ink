# 复制成 .env 再按需修改；不配置也能直接运行。
# 站点
PORT=8787
HOST=127.0.0.1
SITE_TIMEZONE=Asia/Shanghai
DATA_DIR=./data
MAX_UPLOAD_MB=200

# 会话与安全（多实例部署时必须显式设置，且各实例保持一致）
# SESSION_SECRET=换成一串足够长的随机字符串
# COOKIE_SECURE=1        # 上了 HTTPS 再打开
# NODE_ENV=production

# 图像生成：local = 本地程序化生成（不需要密钥）
#           doubao = 火山方舟 / 豆包，需要下面的 Key
IMAGE_PROVIDER=local
# ARK_API_KEY=你的方舟密钥（只放服务端，永远不要提交到 git）
# ARK_MODEL=doubao-seedream-3-0-t2i-250415
# ARK_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
# IMAGE_SIZE=1024x1536

# 自检脚本用（可选）：指定 Chrome / Edge 的路径
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
