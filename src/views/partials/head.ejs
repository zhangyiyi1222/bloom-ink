<!DOCTYPE html>
<html lang="zh-CN" data-world="<%= world %>" data-accent="<%= accent %>" data-page="<%= pageKind %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= pageTitle %></title>
<meta name="description" content="<%= description %>">
<link rel="canonical" href="<%= canonical %>">
<meta property="og:type" content="<%= pageKind === 'article' ? 'article' : 'website' %>">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:site_name" content="<%= site.title %>">
<% if (ogImage) { %>
<meta property="og:image" content="<%= ogImage %>">
<% } %>
<meta name="twitter:card" content="<%= ogImage ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= pageTitle %>">
<meta name="twitter:description" content="<%= description %>">
<% if (ogImage) { %>
<meta name="twitter:image" content="<%= ogImage %>">
<% } %>
<% if (article) { %>
<meta property="article:published_time" content="<%= article.published_at %>">
<% if (article.tags) { %>
<meta property="article:tag" content="<%= article.tags %>">
<% } %>
<% } %>
<meta name="theme-color" content="<%= accentColor %>">
<meta name="color-scheme" content="<%= world === 'ink' ? 'dark' : 'light' %>">
<meta name="bloom-image" content="<%= settings['bloom.image'] || '' %>">
<meta name="ink-image" content="<%= settings['ink.image'] || '' %>">
<link rel="alternate" type="application/rss+xml" title="<%= site.title %> · 全部" href="/rss.xml">
<link rel="alternate" type="application/rss+xml" title="<%= site.title %> · 日志" href="/log/rss.xml">
<link rel="icon" type="image/svg+xml" href="/favicon.ico">
<link rel="preload" as="font" type="font/woff2" href="/static/fonts/SourceHanSerifCN-Regular.woff2" crossorigin>
<link rel="stylesheet" href="/assets/site.css?v=<%= assetVersion %>">
<% if (hasMath) { %>
<link rel="stylesheet" href="/vendor/katex/katex.min.css">
<% } %>
<%
  const sectionKey = locals.section ? locals.section.key : '';
  const sectionImage = sectionKey ? (settings['section.' + sectionKey + '.image'] || '') : '';
%>
<style>
  :root {
    <%- settings['bloom.image'] ? `--bloom-ambient: url('${settings['bloom.image']}');` : '' %>
    <%- settings['ink.image'] ? `--ink-ambient: url('${settings['ink.image']}');` : '' %>
    <%- sectionImage ? `--section-ambient: url('${sectionImage}');` : '' %>
  }

  /* 换页 / 换世界的时候：第一帧就是这个颜色，然后慢慢化开。
     于是新页面是从颜色里“浮”出来的，而不是“啪”地闪出来。 */
  html[data-entering]::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: var(--enter-color, #ffffff);
    transition: opacity 1.25s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  html[data-entering].enter-fade::before {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    html[data-entering]::before {
      transition-duration: 0.15s;
    }
  }
</style>
<script>
  (function () {
    try {
      var color = sessionStorage.getItem('enter-veil');
      // 旧的一层渐变已由颜色渐显取代，这里顺手清掉，避免叠两层
      sessionStorage.removeItem('world-enter');
      if (!color) return;
      sessionStorage.removeItem('enter-veil');
      document.documentElement.dataset.entering = '1';
      document.documentElement.style.setProperty('--enter-color', color);
    } catch (e) {}
  })();
</script>
</head>
<body class="<%= bodyClass %>">
