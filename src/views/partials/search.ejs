<div class="search" id="search" hidden>
  <div class="search__backdrop" data-search-close></div>
  <div class="search__panel" role="dialog" aria-modal="true" aria-label="搜索">
    <input id="search-input" class="search__input" type="search" placeholder="搜索全部文章" autocomplete="off" spellcheck="false" aria-label="搜索关键词">
    <div class="search__hint">空格表示「同时包含」，<code>|</code> 表示「任一」，<code>"短语"</code> 精确匹配 · Esc 关闭</div>
    <div class="search__results" id="search-results"></div>
  </div>
</div>
